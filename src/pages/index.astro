---
import Layout from "../layouts/Layout.astro";

import { getCollection } from "astro:content";

import StickyHorizontalSection from "../components/StickyHorizontalSection.astro";

import { sortByPostDate } from "../utils";

import SectionTextIntro from "../components/SectionTextIntro.astro";
import SectionHomeOutro from "../components/SectionHomeOutro.astro";

const workPosts = await getCollection(
  "posts",
  (p) => p.data.published && p.data.pinned && p.data.category == "work"
);
const blogPosts = await getCollection(
  "posts",
  (p) => p.data.published && p.data.pinned && p.data.category == "blog"
);
---

<Layout title="Frontend Developer">
  <SectionTextIntro />
  <div>
    <h1 class="displaymedium p-t-24 p-b-88 txt-center">My feautured works</h1>
  </div>
  <StickyHorizontalSection data={sortByPostDate(workPosts)} />
  <SectionHomeOutro />
</Layout>
