---
import { Picture } from "astro:assets";
import type { CollectionEntry } from "astro:content";
import SectionHomeOutro from "./SectionHomeOutro.astro";

type Props = {
  data: CollectionEntry<"posts">[];
};

const { data } = Astro.props;
---

<h1 id="home-sticky-title" class="displaymedium">Feautured works</h1>

<div class="sticky-horizontal">
  <div class="wrapper-content">
    {
      data.reverse().map((d, index: number) => {
        if (index > 1) return null;

        const { data, id } = d;

        return (
          <section class="list-item-container">
            <div>
              <div class="preview-container">
                {data.videoContentUrl ? (
                  <video
                    height="500px"
                    controls
                    muted
                    loop
                    playsinline
                    preload="auto"
                    style="border:1px solid gray; border-radius:12px"
                    poster={data.videoPosterUrl}
                  >
                    <source src={data.videoContentUrl} />
                  </video>
                ) : (
                  data.poster && (
                    <Picture
                      src={data.poster}
                      alt="Pinball(Tilt) Game"
                      layout="constrained"
                      formats={["avif", "webp"]}
                      widths={[240, 540, 720, data.poster.width]}
                      sizes={`(max-width: 360px) 240px, (max-width: 720px) 540px, (max-width: 1600px) 720px, ${data.poster.width}px`}
                    />
                  )
                )}
              </div>
              <div class="info-container">
                <h1 class="headlinemedium txt-underline m-v-sm-0">
                  <a href={"/posts/" + data.category + "-" + id}>
                    {data?.title}
                  </a>
                </h1>
                <p>{data.excerpt} </p>
              </div>
            </div>
          </section>
        );
      })
    }
    <section id="section-more-self" class={`list-item-container`}>
      <p class="bodylarge m-auto max-w-600 flex-col-center">
        More works by me on <strong
          ><a href="https://github.com/kuyucakli" style="color:aquamarine"
            >github</a
          ></strong
        > Get in contact on
        <strong
          ><a
            href="https://www.linkedin.com/in/burak-kuyucakl%C4%B1/"
            style="color:rgb(180, 195, 72)">linkedin</a
          ></strong
        >
        My sketches on my <strong
          ><a href="/posts/blog-drawings" style="color:orange">blog</a></strong
        >
      </p>
    </section>
  </div>
</div>

<style>
  video {
    width: 100%;
    max-height: 50dvh;
  }
  #section-more-self {
    margin: 180px 0 280px;
  }
  #home-sticky-title {
    /* opacity: 0;
    position: fixed;
    top: 64px;
    left: 32px;
    transition: all 0.8s ease-in-out;
    transform: translateY(40px); */
    margin: 28px 16px 40px 16px;
  }
  #home-sticky-title.visible {
    opacity: 1;
    transform: translateY(0);
  }

  .sticky-horizontal {
    contain: layout;
    --title-height: 124px;
  }

  .wrapper-content {
    transition: transform 0.1s linear;
    display: flex;
    flex-direction: column;
    gap: 80px;
  }

  .wrapper-content > .list-item-container {
    padding: 8px 12px;
  }

  .info-container {
    flex: 0 0 50px;
    order: 1;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
  }

  .info-container > p {
    max-width: 300px;
  }

  .preview-container {
    flex: 1 0 0;
    order: 0;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    min-width: 300px;
  }

  /* @media (width >= 640px) {
    .info-container > p {
      max-width: 300px;
    }
  } */
  @media screen and (width >= 768px) {
    #home-sticky-title {
      margin: 0;
      opacity: 0;
      position: fixed;

      transition: all 0.8s ease-in-out;
      transform: translateY(40px);
      top: 88px;
      left: 56px;
    }

    .sticky-horizontal {
      width: 100dvw;
      height: 300dvw;
      contain: layout;
      --title-height: 124px;
    }
    .wrapper-content {
      width: 300dvw;
      height: calc(100dvh - var(--title-height));
      position: sticky;
      top: var(--title-height);
      transition: transform 0.1s linear;
      flex-direction: row;
      align-items: stretch;
      will-change: transform;
      transform: translateZ(0); /* trigger GPU acceleration */
    }
    .wrapper-content > .list-item-container {
      flex: 1 0 0;
      display: flex;
      flex-direction: column;
      align-items: stretch;
      justify-content: center;
      overflow: hidden;
      padding: 8px 12px;
    }
    #section-more-self {
      margin: 0;
    }
  }
</style>

<script>
  document.addEventListener("astro:page-load", () => {
    const titleEl = document.getElementById("home-sticky-title");
    const sectionMoreSelfEl = document.getElementById(
      "section-more-self"
    ) as HTMLDivElement;
    let observer: IntersectionObserver;

    const stickyHorizontalEl = document.querySelector(
      ".sticky-horizontal"
    ) as HTMLDivElement;
    const wrapperEl = document.querySelector(
      ".wrapper-content"
    ) as HTMLDivElement;

    let scrollY = window.scrollY || window.pageYOffset;

    let currentProgress = 0;

    function createObserver() {
      observer = new IntersectionObserver(handleIntersection, {
        rootMargin: "100px",
        threshold: [0.0, 0.1, 0.2, 0.3],
      });
    }

    function registerObservedEls() {
      if (!observer) throw "No observer";
      observer.observe(stickyHorizontalEl);
      // observer.observe(sectionMoreSelfEl);
    }

    function handleIntersection(entries: IntersectionObserverEntry[]) {
      entries.forEach((entry) => {
        const { target } = entry;

        if (
          entry.intersectionRatio > 0 &&
          !target.classList.contains("visible")
        ) {
          titleEl!.classList.add("visible");
        } else {
          titleEl!.classList.remove("visible");
        }
      });
    }

    if (window.innerWidth >= 768) {
      createObserver();
      registerObservedEls();

      window.addEventListener("scroll", () => {
        scrollY = window.scrollY || window.pageYOffset;
      });

      animate();
    }

    function animate() {
      const rectTop = stickyHorizontalEl.offsetTop;
      const totalHeight = stickyHorizontalEl.offsetHeight - window.innerHeight;

      const maxTranslateX = wrapperEl.scrollWidth - window.innerWidth;

      const targetProgress = Math.min(
        Math.max((scrollY - rectTop) / totalHeight, 0),
        1
      );

      // Linear interpolation for smoothing
      currentProgress += (targetProgress - currentProgress) * 0.1;

      const translateX = -currentProgress * maxTranslateX;
      wrapperEl.style.transform = `translateX(${translateX}px)`;

      requestAnimationFrame(animate);
    }
  });
</script>
