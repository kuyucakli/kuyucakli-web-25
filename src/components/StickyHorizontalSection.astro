---
import { Picture } from "astro:assets";
import type { CollectionEntry } from "astro:content";

type Props = {
  data: CollectionEntry<"posts">[];
};

const { data } = Astro.props;
const postMaxCount = 3;
---

<nav id="mustache-nav">
  <ul>
    {
      data.map((d, index: number) => (
        <li class={`${index === 0 ? "active" : ""}`}>
          <p class="labellarge">
            <a
              href={"/posts/" + d.data.category + "-" + d.id}
              class="txt-underline"
            >
              {d.data.title}
            </a>
          </p>
        </li>
      ))
    }
  </ul>
</nav>

<div class="sticky-horizontal">
  <div class="wrapper-content">
    {
      data.map((d, index: number) => {
        if (index > postMaxCount - 1) return null;

        const { data, id } = d;

        return (
          <section class="list-item-container">
            <div>
              <div class="preview-container">
                {data.videoContentUrl ? (
                  <video
                    height="500px"
                    controls
                    loop
                    playsinline
                    preload="auto"
                    style="border:1px dotted rgb(75, 75, 75); border-radius:12px"
                    poster={data.videoPosterUrl}
                  >
                    <source src={data.videoContentUrl} />
                  </video>
                ) : (
                  data.poster && (
                    <Picture
                      src={data.poster}
                      alt="Pinball(Tilt) Game"
                      layout="constrained"
                      formats={["avif", "webp"]}
                      widths={[240, 540, 720, data.poster.width]}
                      sizes={`(max-width: 360px) 240px, (max-width: 720px) 540px, (max-width: 1600px) 720px, ${data.poster.width}px`}
                    />
                  )
                )}
              </div>
              <div class="info-container p-t-16">
                <h1 class="headlinemedium txt-underline m-v-sm-0">
                  <a href={"/posts/" + data.category + "-" + id}>
                    {data?.title}
                  </a>
                </h1>
                <p>{data.excerpt} </p>
              </div>
            </div>
          </section>
        );
      })
    }
    <section id="section-more-self" class={`list-item-container`}>
      <p class="bodylarge m-auto max-w-600 flex-col-center">
        More works by me on <strong
          ><a href="https://github.com/kuyucakli" style="color:aquamarine"
            >github</a
          ></strong
        > Get in contact on
        <strong
          ><a
            href="https://www.linkedin.com/in/burak-kuyucakl%C4%B1/"
            style="color:rgb(180, 195, 72)">linkedin</a
          ></strong
        >
        My sketches on my <strong
          ><a href="/posts/blog-drawings" style="color:orange">blog</a></strong
        >
      </p>
    </section>
  </div>
</div>

<style>
  video {
    width: 100%;

    max-height: 50vh;
  }
  #section-more-self {
    margin: 180px 0 280px;
  }

  #mustache-nav {
    width: 500px;
    height: 64px;
    position: fixed;
    bottom: 12px;
    left: 50%;
    transform: translate(-50%, -10%) scale(0.8, 0.2);
    border: 1px dotted black;
    background-color: black;
    border-radius: 24px;
    padding: 12px 24px;
    opacity: 0;
    transition: all 0.4s 0.2s ease-in-out;
    z-index: 11;
  }

  #mustache-nav.active {
    opacity: 1;
    transform: translate(-50%, 0%) scale(1, 1);
  }

  #mustache-nav ul {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    list-style: none;
  }

  #mustache-nav ul li {
    transform: translate(-50%, -200%);
    opacity: 0;
    position: absolute;
    top: 0;
    left: 0;
    transition: all 0.4s 0.2s ease-in-out;
  }

  #mustache-nav ul li p {
    width: max-content;
  }

  #mustache-nav ul li.active {
    transform: translate(-50%, -50%);
    opacity: 1;
  }

  .sticky-horizontal {
    contain: layout;
    --title-height: 0px;
  }

  .wrapper-content {
    transition: transform 0.1s linear;
    display: flex;
    flex-direction: column;
    gap: 80px;
  }

  .wrapper-content > .list-item-container {
    padding: 8px 12px;
  }

  .info-container {
    flex: 0 0 50px;
    order: 1;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    position: fixed;
    bottom: 0;
    left: 0;
    display: none;
  }

  .info-container > p {
    max-width: 500px;
  }

  .preview-container {
    flex: 1 0 0;
    order: 0;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    min-width: 300px;
  }

  .wrapper-content video {
    opacity: 0;
    transition: opacity 2s ease-in;
  }
  .wrapper-content video.is-visible {
    opacity: 1;
  }

  /* @media (width >= 640px) {
    .info-container > p {
      max-width: 300px;
    }
  } */
  @media screen and (width >= 768px) {
    video {
      width: 75%;
    }

    .sticky-horizontal {
      width: 100dvw;
      height: 400dvw;
      contain: layout;
      --title-height: 0px;
    }
    .wrapper-content {
      width: 400dvw;
      height: calc(100dvh - var(--title-height));
      position: sticky;
      top: var(--title-height);
      transition: transform 0.1s linear;
      flex-direction: row;
      align-items: stretch;
      will-change: transform;
      transform: translateZ(0); /* trigger GPU acceleration */
    }

    .wrapper-content > .list-item-container {
      flex: 1 0 0;
      display: flex;
      flex-direction: column;
      align-items: stretch;
      justify-content: center;
      overflow: hidden;
      padding: 8px 12px;
    }
    #section-more-self {
      margin: 0;
    }
  }
</style>

<script>
  document.addEventListener("astro:page-load", () => {
    const mustacheNavEl = document.getElementById("mustache-nav");

    let observer: IntersectionObserver;

    const stickyHorizontalEl = document.querySelector(
      ".sticky-horizontal",
    ) as HTMLDivElement;
    const wrapperEl = document.querySelector(
      ".wrapper-content",
    ) as HTMLDivElement;

    if (!stickyHorizontalEl || !wrapperEl) return;
    const videos = wrapperEl.querySelectorAll("video");

    let scrollY = window.scrollY || window.pageYOffset;

    let currentProgress = 0;

    function createObserver() {
      observer = new IntersectionObserver(handleIntersection, {
        rootMargin: "100px",
        threshold: [0.0, 0.1, 0.2, 0.3],
      });
    }

    function registerObservedEls() {
      if (!observer) throw "No observer";
      observer.observe(stickyHorizontalEl);
      // observer.observe(sectionMoreSelfEl);
    }

    function handleIntersection(entries: IntersectionObserverEntry[]) {
      entries.forEach((entry) => {
        const { target } = entry;

        if (
          entry.intersectionRatio > 0 &&
          !target.classList.contains("active")
        ) {
          mustacheNavEl!.classList.add("active");
        } else {
          mustacheNavEl!.classList.remove("active");
        }
      });
    }

    const videoObserver = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          const video = entry.target as HTMLVideoElement;

          if (entry.isIntersecting) {
            video.classList.add("is-visible");
          } else {
            video.classList.remove("is-visible");
          }
        });
      },
      {
        root: null, // viewport
        threshold: 0.01,
      },
    );

    videos.forEach((video) => {
      videoObserver.observe(video);
    });

    createObserver();
    registerObservedEls();

    if (window.innerWidth >= 768) {
      window.addEventListener("scroll", () => {
        scrollY = window.scrollY || window.pageYOffset;
      });
      animate();
    } else {
      // 2. On mobile, we still need to update the active item based on vertical scroll
      window.addEventListener("scroll", () => {
        updateActiveNavItem();
      });
    }

    function updateActiveNavItem() {
      const items = wrapperEl.querySelectorAll(".list-item-container");
      const navItems = mustacheNavEl.querySelectorAll("li");

      // On mobile, we check the vertical center; on desktop, the horizontal center
      const isDesktop = window.innerWidth >= 768;
      const viewportCenter = isDesktop
        ? window.innerWidth / 2
        : window.innerHeight / 2;

      let closestIndex = 0;
      let minDistance = Infinity;

      items.forEach((item, index) => {
        const rect = item.getBoundingClientRect();
        // Distance from center depends on scroll direction
        const itemCenter = isDesktop
          ? rect.left + rect.width / 2
          : rect.top + rect.height / 2;
        const distance = Math.abs(viewportCenter - itemCenter);

        if (distance < minDistance) {
          minDistance = distance;
          closestIndex = index;
        }
      });

      navItems.forEach((navItem, index) => {
        navItem.classList.toggle("active", index === closestIndex);
      });
    }

    function animate() {
      const rectTop = stickyHorizontalEl.offsetTop;
      const totalHeight = stickyHorizontalEl.offsetHeight - window.innerHeight;

      const maxTranslateX = wrapperEl.scrollWidth - window.innerWidth;

      const targetProgress = Math.min(
        Math.max((scrollY - rectTop) / totalHeight, 0),
        1,
      );

      // Linear interpolation for smoothing
      currentProgress += (targetProgress - currentProgress) * 0.1;

      const translateX = -currentProgress * maxTranslateX;
      wrapperEl.style.transform = `translateX(${translateX}px)`;

      updateActiveNavItem();

      requestAnimationFrame(animate);
    }
  });
</script>
