---
const { text, letterBiggerZindex, zIndex, class: className } = Astro.props;
const letters = text.split("");
---

{
  letters.map((l: string, index: number) => {
    if (letterBiggerZindex.includes(index)) {
      return (
        <span
          class="depth-letter"
          style={`z-index:${zIndex}; filter: blur(1.8px)`}
        >
          {l}
        </span>
      );
    }
    return <span class="depth-letter">{l}</span>;
  })
}

<style>
  span {
    font-size: clamp(120px, 10vw, 240px);
    font-weight: 800;
    opacity: 1;
    background: radial-gradient(#d1ff8c 0%, #7effc7 70%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    position: relative;
    filter: blur(1px);

    transition: all 1s ease-out;
  }
</style>
