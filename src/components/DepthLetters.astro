---
const { text, letterBiggerZindex, zIndex } = Astro.props;
const letters = text.split("");
---

{
  letters.map((l: string, index: number) => {
    if (letterBiggerZindex.includes(index)) {
      return (
        <span
          class="depth-letter"
          style={`z-index:${zIndex}; filter: blur(1.8px)`}
        >
          {l}
        </span>
      );
    }
    return <span class="depth-letter">{l}</span>;
  })
}

<style>
  span {
    font-size: clamp(80px, 10vw, 112px);
    opacity: 1;
    background: radial-gradient(#d0d0d0 0%, #fff7f5 70%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    position: relative;
    filter: blur(2.8px);
    font-family: "Kirang Haerang";
    transition: all;
  }
</style>
