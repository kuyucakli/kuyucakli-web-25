---
import { IconBackArrow } from "./Icons";

const { url = "/" } = Astro.props;
---

<a href={url} id="btn-back" class="titlemedium flex-vertical-center">
  <span><IconBackArrow fill="var(--clr-on-surface)" width={24} /></span>
  <!-- Back -->
</a>

<style>
  a span {
    display: inline-flex;
    width: 40px;
    height: 40px;
    align-items: center;
    justify-content: center;
    border-radius: 50%;
  }
</style>

<script>
  document.addEventListener("astro:after-swap", init);

  function init() {
    document.getElementById("btn-back")?.addEventListener("click", (e) => {
      e.preventDefault();
      history.back();
    });
  }
</script>
