---
import { Picture } from "astro:assets";

const { data, id } = Astro.props;
---

<li class="relative">
  <div>
    <div style="mix-blend-mode: difference;" class="container-text">
      <h1 class="headlinesmall m-b-8">
        {data.title}
      </h1>
      <p class="m-b-16 bodysmall">
        {
          data.createdAt.toLocaleDateString("en-us", {
            weekday: "long",
            year: "numeric",
            month: "short",
            day: "numeric",
          })
        }
      </p>
      <p>
        {data.excerpt}
      </p>
    </div>
    {
      data.poster ? (
        <Picture
          src={data?.poster}
          alt="Pinball(Tilt) Game"
          formats={["avif", "webp"]}
          widths={[240, 540, 720, data?.poster?.width]}
          sizes={`(max-width: 360px) 240px, (max-width: 720px) 540px, (max-width: 1600px) 720px, ${data?.poster?.width}px`}
        />
      ) : null
    }
  </div>
  <a
    href={"/posts/" + data.category + "-" + id}
    class="cover-link"
    aria-label={data.title}></a>
</li>

<style>
  .container-text {
    padding: 16px;
  }
  div {
    position: relative;
    width: 100%;
    height: 100%;
  }

  img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    position: absolute;
    top: 0;
    left: 0;
  }
  div > div {
    position: relative;
    z-index: 1;
  }
</style>
