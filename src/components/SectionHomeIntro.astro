---
import ThreeScene from "./3d";
import DepthLetters from "./DepthLetters.astro";
---

<div
  id="sticky-home-intro-container"
  style="height:180vmax; pointer-events: none;"
>
  <section
    style="display:flex; align-content:center; flex-direction:colum; justify-content:center;  flex-wrap:wrap; width:100vw; height:100dvh; top:0; left:0;
    overflow-x:hidden; background-attachment: fixed; "
  >
    <div
      id="depth-letters-layer"
      style="position:fixed; transform:translateY( calc( 50dvh - 80px ) )"
    >
      <DepthLetters
        text="frontback"
        letterBiggerZindex={[2, 4, 6, 8]}
        zIndex="11"
      />
    </div>

    <div
      id="intro-home-text"
      style="width:100%;  padding:0 24px;  background: radial-gradient(#d0d0d0 0%, #fff7f5 70%);
  -webkit-background-clip: text;
 
  z-index:9; 
  opacity:0.7;   
  position:fixed;
   transform:translateY( calc( 50dvh + 40px ) );
  left:0;
  
  "
      class="titlemedium"
    >
      <p
        style="max-width:500px; margin:0 auto;  -webkit-font-smoothing: antialiased;
  -moz-osx-font-smoothing: grayscale; "
      >
        I'm Burak Kuyucaklı from Istanbul, a <strong
          style="color:rgb(144, 255, 203)!important;  border-radius:6px; "
          >creative frontend developer and designer</strong
        > who enjoys making things work <strong
          style="color:rgb(255, 242, 0)!important;  border-radius:6px"
          >smoothly
        </strong>for people through <strong
          style="color:rgb(255, 156, 162)!important;  border-radius:6px"
          >code</strong
        >.. While frontend is my main focus, I’m deeply interested in backend
        development. I have my <strong
          style="color:rgb(79, 161, 255)!important;  border-radius:6px"
          >paper, pen and brushes</strong
        > while thinking on ux-ui.
      </p>
    </div>
    <ThreeScene client:load />
  </section>
</div>

<script>
  import { initScrollTracker, registerElement } from "../../src/utils/scroll";

  document.addEventListener("astro:page-load", () => {
    const stickyContainer = document.getElementById(
      "sticky-home-intro-container"
    ) as HTMLDivElement;
    const introHomeTextEl = document.getElementById(
      "intro-home-text"
    ) as HTMLDivElement;
    const depthLayerEl = document.getElementById(
      "depth-letters-layer"
    ) as HTMLDivElement;

    if (!introHomeTextEl) return;

    initScrollTracker();

    /* -------------------------
       Responsive limits
    -------------------------- */
    const vw = Math.max(
      document.documentElement.clientWidth,
      window.innerWidth || 0
    );

    const vh = Math.max(
      document.documentElement.clientHeight,
      window.innerHeight || 0
    );

    const maxScale = vw < 480 ? 2.1 : vw < 768 ? 2.4 : vw < 1024 ? 2.7 : 3.1;

    /* -------------------------
       Smoothed state
    -------------------------- */
    let y = 0;
    let scale = 1;
    let blur = 0;
    let opacity = 0.7;
    let depthY = 0;
    let depthOpacity = 1;

    /* -------------------------
       Tunables
    -------------------------- */
    const POSITION_LAG = 0.08;
    const SCALE_LAG = 0.01;
    const BLUR_LAG = 0.02;
    const OPACITY_LAG = 0.01;
    const DEPTH_LAG = 0.1;
    const DEPTH_OPACITY_LAG = 0.12;

    const SCALE_START = 0.4;

    registerElement(stickyContainer, (progress) => {
      /* ---------- Targets ---------- */
      const targetY = -progress * 400;

      const scaleProgress =
        progress < SCALE_START
          ? 0
          : (progress - SCALE_START) / (1 - SCALE_START);

      const rawScale = 1 + scaleProgress * 2.8;
      const targetScale = Math.min(rawScale, maxScale);

      const targetBlur = progress * 1.5;
      const targetOpacity = 0.7 - progress * 0.68;

      /* ---------- Smooth ---------- */
      y += (targetY - y) * POSITION_LAG;
      scale += (targetScale - scale) * SCALE_LAG;
      blur += (targetBlur - blur) * BLUR_LAG;
      opacity += (targetOpacity - opacity) * OPACITY_LAG;

      /* ---------- Apply ---------- */
      introHomeTextEl.style.transform = `translateY(${y + vh / 2 + 40}px) scale(${scale})`;
      introHomeTextEl.style.filter = `blur(${blur}px)`;
      introHomeTextEl.style.opacity = `${opacity}`;

      /* ---------- Depth layer targets ---------- */
      const depthTargetY = -progress * 380;
      const depthTargetOpacity = 1 - progress;

      /* ---------- Smooth ---------- */
      depthY += (depthTargetY - depthY) * DEPTH_LAG;
      depthOpacity += (depthTargetOpacity - depthOpacity) * DEPTH_OPACITY_LAG;

      /* ---------- Apply ---------- */
      depthLayerEl.style.transform = `translateY(${depthY - 80 + vh / 2}px)`;
      depthLayerEl.style.opacity = `${depthOpacity}`;
    });
  });
</script>
