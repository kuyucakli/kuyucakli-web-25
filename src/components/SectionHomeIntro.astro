---
import ThreeScene from "./3d";
import DepthLetters from "./DepthLetters.astro";
---

<div id="sticky-home-intro-container" style="height:200dvmax; ">
  <section
    style="display:flex; align-content:center; flex-direction:colum; justify-content:center;  flex-wrap:wrap; width:100dvw; height:100dvh; background:radial-gradient(#433e3e 0%, var(--clr-surface) 70%); position:sticky; top:0; left:0;
    overflow-x:hidden;"
  >
    <DepthLetters
      text="'frontback'"
      letterBiggerZindex={[2, 4, 6, 8]}
      zIndex="11"
    />

    <div
      id="intro-home-text"
      style="width:100%;  padding:24px;  background: radial-gradient(#d0d0d0 0%, #fff7f5 70%);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  z-index:9;   -webkit-font-smoothing: antialiased;
  -moz-osx-font-smoothing: grayscale;
  "
      class="bodylarge"
    >
      <p style="max-width:480px; margin:0 auto;  ">
        I'm Burak Kuyucaklı from Istanbul, a frontend developer who enjoys
        making things work smoothly for people through code. While frontend is
        my main focus, I’m deeply interested in backend development. I have my
        paper, pen and brushes while thinking on ux-ui.
      </p>
    </div>
    <ThreeScene client:load />
  </section>
</div>

<script>
  import { initScrollTracker, registerElement } from "../../src/utils/scroll";
  initScrollTracker();

  const stickyContainer = document.getElementById(
    "sticky-home-intro-container"
  );
  const introHomeTextEl = document.getElementById("intro-home-text");

  registerElement(stickyContainer!, (progress) => {
    console.log(progress);
    const scale = 1 + progress * 1.5; // scale from 1 -> 1.5
    const opacity = 0.8 - progress;
    introHomeTextEl!.style.transform = `scale(${scale})`;
    introHomeTextEl!.style.opacity = `${opacity}`;
  });
</script>
