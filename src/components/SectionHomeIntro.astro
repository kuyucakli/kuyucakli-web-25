---
import ThreeScene from "./3d";
import DepthLetters from "./DepthLetters.astro";
---

<div id="sticky-home-intro-container" style="height:180dvmax; ">
  <section
    style="display:flex; align-content:center; flex-direction:colum; justify-content:center;  flex-wrap:wrap; width:100dvw; height:100dvh; background:radial-gradient(#433e3e 0%, var(--clr-surface) 70%); position:sticky; top:0; left:0;
    overflow-x:hidden; background-attachment: fixed;"
  >
    <DepthLetters
      text="'frontback'"
      letterBiggerZindex={[2, 4, 6, 8]}
      zIndex="11"
    />

    <div
      id="intro-home-text"
      style="width:100%;  padding:0 24px;  background: radial-gradient(#d0d0d0 0%, #fff7f5 70%);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  z-index:9; 
  opacity:0.7;   
  
  "
      class="bodylarge"
    >
      <p
        style="max-width:500px; margin:0 auto;  -webkit-font-smoothing: antialiased;
  -moz-osx-font-smoothing: grayscale; "
      >
        I'm Burak Kuyucaklı from Istanbul, a frontend developer who enjoys
        making things work smoothly for people through code. While frontend is
        my main focus, I’m deeply interested in backend development. I have my
        paper, pen and brushes while thinking on ux-ui.
      </p>
    </div>
    <ThreeScene client:load />
  </section>
</div>

