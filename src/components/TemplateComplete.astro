---
import { Picture } from "astro:assets";

const { data, id } = Astro.props;
---

<li class="relative">
  <div class="container-text">
    <h1 class="headlinesmall m-b-8">
      <a href={"/posts/" + data.category + "-" + id}>{data?.title}</a>
    </h1>
    <p class="m-b-16 bodysmall">
      {
        data.createdAt.toLocaleDateString("en-us", {
          year: "numeric",
          month: "short",
        })
      }
    </p>
    <p class="excerpt-text">{data?.excerpt}</p>
  </div>
  {
    data?.poster ? (
      <Picture
        src={data?.poster}
        alt="Pinball(Tilt) Game"
        formats={["avif", "webp"]}
        widths={[240, 540, 720, data?.poster?.width]}
        sizes={`(max-width: 360px) 240px, (max-width: 720px) 540px, (max-width: 1600px) 720px, ${data?.poster?.width}px`}
        class="m-auto"
      />
    ) : null
  }
  <a
    href={"/posts/" + data.category + "-" + id}
    class="cover-link"
    aria-label={data.title}></a>
</li>

<style>
  .excerpt-text {
    min-height: 48px;
  }
  p {
  }
  .container-text {
    padding: 16px;
  }
  picture {
    display: block;
    text-align: center;
  }
</style>
